NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/feedback_management_db?retryWrites=true&w=majority
JWT_SECRET=<replace-me>
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# V2.1 — OpenAPI/Swagger (both optional, default "true"). Set to "false" in
# a turnover/production environment to disable the /api-docs and
# /openapi.json routes entirely, or just the interactive "Try it out"
# executor, without touching application code.
API_DOCS_ENABLED=true
API_DOCS_TRY_IT_OUT_ENABLED=true
