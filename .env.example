NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/apiv2?retryWrites=true&w=majority
JWT_SECRET=<replace-me>
JWT_EXPIRES_IN=1d

# The frontend origin CORS is restricted to (app.js). Required when
# NODE_ENV=production — startup fails fast if unset in that case, so a
# forgotten value can't silently leave CORS misconfigured against the real
# Netlify deployment. Optional in development (defaults to
# http://localhost:5173).
CLIENT_URL=http://localhost:5173

# V2.1 — OpenAPI/Swagger. API_DOCS_ENABLED (default "true" everywhere) gates
# the /api-docs and /openapi.json routes entirely. API_DOCS_TRY_IT_OUT_ENABLED
# gates only the interactive "Try it out" executor (which calls the real API
# against real data): opt-out in development/test (enabled unless set to
# "false"), but opt-IN in production (disabled unless explicitly set to
# "true") — a forgotten value fails safe in production.
API_DOCS_ENABLED=true
API_DOCS_TRY_IT_OUT_ENABLED=true
